### Manual API smoke tests (VS Code REST Client / IntelliJ HTTP client)
@api = http://localhost:4000/api
@demo = http://localhost:4100

### API + database health
GET {{api}}/health

### Unknown route -> structured 404
GET {{api}}/nope

# ---------- auth ----------

### Log in as the seeded admin (copy `token` into @token below)
# @name login
POST {{api}}/auth/login
Content-Type: application/json

{ "email": "admin@pulsewatch.local", "password": "pulsewatch123" }

@token = {{login.response.body.token}}

### Wrong password -> 401
POST {{api}}/auth/login
Content-Type: application/json

{ "email": "admin@pulsewatch.local", "password": "nope" }

### Current user
GET {{api}}/auth/me
Authorization: Bearer {{token}}

### No token -> 401
GET {{api}}/auth/me

# ---------- services ----------

### List services
GET {{api}}/services
Authorization: Bearer {{token}}

### Create a service (admin only)
POST {{api}}/services
Authorization: Bearer {{token}}
Content-Type: application/json

{ "name": "checkout-api", "description": "Cart and checkout flow", "tags": ["critical"] }

### Invalid name -> 400 with field details
POST {{api}}/services
Authorization: Bearer {{token}}
Content-Type: application/json

{ "name": "Not A Slug!" }

# ---------- monitors ----------

### Monitors for service 1
GET {{api}}/services/1/monitors
Authorization: Bearer {{token}}

### Add a monitor (admin only)
POST {{api}}/services/1/monitors
Authorization: Bearer {{token}}
Content-Type: application/json

{ "url": "http://localhost:4100/health", "intervalSeconds": 60, "timeoutMs": 5000,
  "expectedStatus": 200, "failureThreshold": 3, "recoveryThreshold": 2 }

### Interval below the 30s floor -> 400
POST {{api}}/services/1/monitors
Authorization: Bearer {{token}}
Content-Type: application/json

{ "url": "http://localhost:4100/health", "intervalSeconds": 5, "timeoutMs": 5000,
  "expectedStatus": 200, "failureThreshold": 3, "recoveryThreshold": 2 }

### Pause a monitor
PATCH {{api}}/monitors/1
Authorization: Bearer {{token}}
Content-Type: application/json

{ "status": "paused" }

### Resume it ('unknown' lets the worker decide up/down again)
PATCH {{api}}/monitors/1
Authorization: Bearer {{token}}
Content-Type: application/json

{ "status": "unknown" }

### Setting 'up' by hand -> 400, that belongs to the worker
PATCH {{api}}/monitors/1
Authorization: Bearer {{token}}
Content-Type: application/json

{ "status": "up" }

### Check results (populated in Phase 2)
GET {{api}}/monitors/1/results
Authorization: Bearer {{token}}

# ---------- incidents ----------

### List incidents (filters: status, serviceId, severity, q)
GET {{api}}/incidents
Authorization: Bearer {{token}}

### Only the open ones
GET {{api}}/incidents?status=open
Authorization: Bearer {{token}}

### Create one by hand
# @name manual
POST {{api}}/incidents
Authorization: Bearer {{token}}
Content-Type: application/json

{ "serviceId": 1, "title": "Checkout returning 500s", "description": "Card payments failing",
  "severity": "SEV2", "errorType": "HTTP_5XX" }

@incident = {{manual.response.body.id}}

### Detail with the full timeline
GET {{api}}/incidents/{{incident}}
Authorization: Bearer {{token}}

### Acknowledge (engineer or admin; 409 if already acknowledged)
POST {{api}}/incidents/{{incident}}/acknowledge
Authorization: Bearer {{token}}

### Comment — allowed even after resolution
POST {{api}}/incidents/{{incident}}/comments
Authorization: Bearer {{token}}
Content-Type: application/json

{ "message": "Pool exhausted, restarting it" }

### Change severity (logged as severity_changed)
PATCH {{api}}/incidents/{{incident}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "severity": "SEV1" }

### Resolve with a note (409 if already resolved)
POST {{api}}/incidents/{{incident}}/resolve
Authorization: Bearer {{token}}
Content-Type: application/json

{ "note": "Restarted the DB connection pool" }

# ---------- search ----------

### Full text across incidents and runbooks
GET {{api}}/search?q=connection pool
Authorization: Bearer {{token}}

### Stemming: 'restarting' matches 'restarted'
GET {{api}}/search?q=restarting
Authorization: Bearer {{token}}

### Typo -> no full-text hits, falls back to trigram (response has fuzzy: true)
GET {{api}}/search?q=databse timeuts
Authorization: Bearer {{token}}

# ---------- git links ----------

### Link the PR that fixed an incident
POST {{api}}/incidents/1/commits
Authorization: Bearer {{token}}
Content-Type: application/json

{ "kind": "fixed_by", "repo": "acme/payments-api", "commitSha": "9f2c1ab3de",
  "prUrl": "https://github.com/acme/payments-api/pull/412" }

# ---------- api keys and ingest ----------

### Create a key (admin only, full key shown once)
# @name apikey
POST {{api}}/services/1/api-keys
Authorization: Bearer {{token}}

@key = {{apikey.response.body.key}}

### List keys (prefix only, never the full key)
GET {{api}}/services/1/api-keys
Authorization: Bearer {{token}}

### Report an error -> opens an incident
POST {{api}}/ingest/errors
X-Api-Key: {{key}}
Content-Type: application/json

{ "errorType": "DB_TIMEOUT",
  "message": "Timeout after 5000ms connecting to 10.0.3.17:5432",
  "severity": "SEV2" }

### Same problem, different numbers -> deduplicated onto the same incident
POST {{api}}/ingest/errors
X-Api-Key: {{key}}
Content-Type: application/json

{ "errorType": "DB_TIMEOUT",
  "message": "Timeout after 3000ms connecting to 10.0.3.22:5432",
  "severity": "SEV2" }

### No key -> 401
POST {{api}}/ingest/errors
Content-Type: application/json

{ "errorType": "DB_TIMEOUT", "message": "no key" }

# ---------- stats, status page, postmortem ----------

### Dashboard numbers: MTTR, MTTA, repeat rate, health, per-service counts
GET {{api}}/stats/overview
Authorization: Bearer {{token}}

### Public status page data -- deliberately needs NO auth
GET {{api}}/public/status

### Postmortem, as Markdown
GET {{api}}/incidents/11/postmortem
Authorization: Bearer {{token}}

# ---------- demo target ----------

### What the alerting webhook received (sink for local testing)
GET {{demo}}/webhook

### Clear the sink
DELETE {{demo}}/webhook

### Current mode
GET {{demo}}/mode

### Break it
POST {{demo}}/mode
Content-Type: application/json

{ "mode": "failing" }

### Fix it
POST {{demo}}/mode
Content-Type: application/json

{ "mode": "healthy" }
