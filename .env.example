# ---- database ----
DATABASE_URL=postgresql://pulsewatch:pulsewatch@localhost:5432/pulsewatch
# Used only by docker compose to create the local database
POSTGRES_USER=pulsewatch
POSTGRES_PASSWORD=pulsewatch
POSTGRES_DB=pulsewatch

# ---- api ----
API_PORT=4000
NODE_ENV=development
# The API refuses to start in production with this placeholder or anything
# under 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:5173

# ---- alerts ----
# Both optional: with neither set, PulseWatch simply stays quiet.
# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=
# To test alerting without Discord, point it at the demo target's sink:
#   DISCORD_WEBHOOK_URL=http://localhost:4100/webhook
# then read the captured payloads from GET http://localhost:4100/webhook
SMTP_URL=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=PulseWatch <alerts@pulsewatch.local>

# ---- worker ----
WORKER_POLL_SECONDS=5
WORKER_CONCURRENCY=10
RESULTS_RETENTION_DAYS=14

# ---- security (SSRF) ----
# true lets monitors reach localhost and private ranges, which local development
# needs for the demo target. In production the API and worker refuse to start
# with this set to true.
ALLOW_PRIVATE_MONITOR_TARGETS=true
# Exact hostnames or IPs exempt from the SSRF check, comma separated. This is
# how to allow one internal host (e.g. a demo target on a private network) in
# production without opening every private address.
MONITOR_HOST_ALLOWLIST=

# ---- tests ----
# The API and E2E suites do NOT read this file. They use the environment
# variable TEST_DATABASE_URL, defaulting to
#   postgresql://pulsewatch:pulsewatch@localhost:5432/pulsewatch_test
# They truncate every table, so they refuse any database whose name does not
# end in "_test".

# ---- demo target ----
DEMO_TARGET_PORT=4100

# ---- web (Vite) ----
VITE_API_URL=http://localhost:4000
