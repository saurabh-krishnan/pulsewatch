# ---- database ----
DATABASE_URL=postgresql://pulsewatch:pulsewatch@localhost:5432/pulsewatch
# Used only by docker compose to create the local database
POSTGRES_USER=pulsewatch
POSTGRES_PASSWORD=pulsewatch
POSTGRES_DB=pulsewatch

# ---- api ----
API_PORT=4000
NODE_ENV=development
JWT_SECRET=change-me
JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:5173

# ---- alerts ----
# Both optional: with neither set, PulseWatch simply stays quiet.
# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=
# To test alerting without Discord, point it at the demo target's sink:
#   DISCORD_WEBHOOK_URL=http://localhost:4100/webhook
# then read the captured payloads from GET http://localhost:4100/webhook
SMTP_URL=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=PulseWatch <alerts@pulsewatch.local>

# ---- worker ----
WORKER_POLL_SECONDS=5
WORKER_CONCURRENCY=10
RESULTS_RETENTION_DAYS=14

# ---- security ----
# Allow monitors to target private/loopback addresses. MUST stay false in production (SSRF).
ALLOW_PRIVATE_MONITOR_TARGETS=true

# ---- demo target ----
DEMO_TARGET_PORT=4100

# ---- web (Vite) ----
VITE_API_URL=http://localhost:4000
