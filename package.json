{
  "name": "pulsewatch",
  "version": "0.1.0",
  "private": true,
  "description": "Uptime monitoring and incident knowledge platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:worker dev:web dev:demo",
    "dev:api": "npm run dev -w @pulsewatch/api",
    "dev:worker": "npm run dev -w @pulsewatch/worker",
    "dev:web": "npm run dev -w @pulsewatch/web",
    "dev:demo": "npm run dev -w @pulsewatch/demo-target",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --build --force",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "verify:skip-locked": "tsx scripts/verify-skip-locked.ts",
    "pg:start": "powershell -ExecutionPolicy Bypass -File scripts/pg-start.ps1",
    "pg:stop": "powershell -ExecutionPolicy Bypass -File scripts/pg-stop.ps1",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test:unit": "vitest run --project unit",
    "test:api": "vitest run --project api",
    "test:e2e": "playwright test",
    "e2e:api": "tsx apps/api/src/index.ts",
    "e2e:worker": "tsx apps/worker/src/index.ts",
    "e2e:demo": "tsx apps/demo-target/src/index.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "npm-run-all2": "^7.0.2",
    "prettier": "^3.4.2",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
